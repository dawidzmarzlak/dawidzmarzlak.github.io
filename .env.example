# Google Analytics
# Get your Measurement ID from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI Chatbot Configuration
# Provider: "ollama" (self-hosted) or "gemini" (Google API)
CHAT_PROVIDER=ollama

# ===== OLLAMA (self-hosted) =====
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional: API key for production (if using nginx auth)
# OLLAMA_API_KEY=your_secret_key

# ===== GEMINI (Google API) =====
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-1.5-flash

# ===== BOT PROTECTION (Cloudflare Turnstile) =====
# Get your keys from: https://dash.cloudflare.com → Turnstile
# Test keys (always pass): Site=1x00000000000000000000AA Secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
