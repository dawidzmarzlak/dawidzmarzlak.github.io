# IT Solutions stack env vars.
# Used by docker-compose.yml AND by `npm run dev` (Next reads .env / .env.local).
# Copy to `.env` and customize. NEVER commit your real `.env`.
#
# === Database ===
DB_NAME=itsolutions
DB_USER=postgres
DB_PASSWORD=please-change-me-in-prod
POSTGRES_PORT=5432

# === Backend ===
SPRING_PROFILE=prod
# 256-bit secret, base64-encoded (Spring decodes via Decoders.BASE64). Generate:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=please-generate-a-base64-encoded-secret-here-must-be-at-least-32-bytes-decoded
ADMIN_EMAIL=admin@itsolutions.pl

# === Email (SMTP) ===
# dev: mailhog kontener (no auth, port 1025)
# prod: Postmark / SendGrid / Mailgun — API-key login + port 587
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@itsolutions.pl

# === LLM ===
# Two providers always available — switch via primary/fallback.
# Examples:
#   LLM_PRIMARY=gemini  LLM_FALLBACK=ollama   → Gemini first, fallback to Ollama on quota/429
#   LLM_PRIMARY=ollama  LLM_FALLBACK=         → Ollama only
#   LLM_PRIMARY=gemini  LLM_FALLBACK=         → Gemini only
LLM_PRIMARY=ollama
LLM_FALLBACK=
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# === Bot protection (Cloudflare Turnstile) ===
# https://dash.cloudflare.com → Turnstile
# Test keys (always pass): Site=1x00000000000000000000AA Secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# === Frontend (Next.js) ===
# In Docker the frontend is built with these baked in (build args). For local
# `npm run dev` they're read at runtime as ordinary env vars.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Domains (Caddy production) ===
# Used by ./Caddyfile. For local dev, ./Caddyfile.dev hardcodes localhost.
DOMAIN_PUBLIC=itsolutions.pl
DOMAIN_API=api.itsolutions.pl
DOMAIN_ADMIN=admin.itsolutions.pl
ACME_EMAIL=admin@itsolutions.pl

# === BO isolation ===
# Default: separate `admin.*` subdomain + Basic Auth (Caddy) + JWT (app).
# Optional: add IP allowlist later — see deploy/README.md.
ADMIN_URL=https://admin.itsolutions.pl
PUBLIC_URL=https://itsolutions.pl
CORS_ORIGINS=https://itsolutions.pl
