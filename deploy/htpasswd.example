# Caddy Basic Auth credentials for admin.itsolutions.pl.
# Copy to deploy/htpasswd and replace the hash with one generated for your password.
#
# Generate a hash:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "your-strong-password"
# Or:
#   htpasswd -nbB admin "your-strong-password"
#
# Format: <username> <bcrypt-hash>  (one per line)

admin $2a$14$REPLACE_ME_WITH_A_REAL_BCRYPT_HASH_FOR_YOUR_ADMIN_PASSWORD
