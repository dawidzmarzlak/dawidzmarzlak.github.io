# Dev Caddyfile — local development without HTTPS.
# Add to C:\Windows\System32\drivers\etc\hosts (or /etc/hosts):
#   127.0.0.1 api.localhost admin.localhost

{
    auto_https off
}

# Public site
:80 {
    reverse_proxy frontend:80
}

# Backend API
api.localhost:80 {
    reverse_proxy backend:8080
}

# Admin BO — Basic Auth only (dev). JWT remains the real auth layer.
# Default credentials: admin / admin123
# Hash generated with: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "admin123"
admin.localhost:80 {
    basicauth {
        admin $2a$14$tsjJKaCi1WnKzrLF8Ty7P.OTATYf2K5ZgduVzUa4zPN4f3uSCdfyi
    }
    reverse_proxy admin:80
}
